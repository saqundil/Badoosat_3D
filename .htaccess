# Point the document root at public/ where the host allows it. This rewrite is
# the fallback for shared hosting that serves the project root.
RewriteEngine On

RewriteRule ^(src|config|storage|vendor|tools|build|node_modules)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock))$ - [F,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
