# Uploads are data, never code. An SVG that reaches this folder has already been
# stripped; the untouched original is kept in storage/, outside the web root.
php_flag engine off

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
AddType text/plain .php .phtml .phar

<FilesMatch "(?i)\.(php|php[0-9]|phtml|phar|htaccess|inc)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:"
</IfModule>
