/* Self-hosted so the page owes nothing to a third-party CDN. Anton and Cairo
   are both SIL Open Font License; the licences sit beside the woff2 files. */

@font-face {
    font-family: 'Anton';
    src: url('/assets/fonts/anton-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122, U+2212;
}

@font-face {
    font-family: 'Cairo';
    src: url('/assets/fonts/cairo-arabic-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+200C-200E, U+2010-2011, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
    font-family: 'Cairo';
    src: url('/assets/fonts/cairo-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122, U+2212;
}

@font-face {
    font-family: 'Cairo';
    src: url('/assets/fonts/cairo-arabic-900-normal.woff2') format('woff2');
    font-weight: 900;
    font-display: swap;
    unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+200C-200E, U+2010-2011, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
    font-family: 'Cairo';
    src: url('/assets/fonts/cairo-latin-900-normal.woff2') format('woff2');
    font-weight: 900;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122, U+2212;
}

:root {
    --paper: #edebe6;
    --card: #141414;
    --ink: #0b0b0c;
    --dim: #8a8a85;
    --muted: #6d6a63;
    --hazard: #e9c400;
    --line: #d8d4cb;

    --card-radius: 54px;
    --hero-frame: clamp(12px, 1.8cqw, 24px);
    --hero-surface-top: var(--hero-frame);
    --surface-radius: calc(var(--card-radius) - var(--hero-frame) / 2);
    --tab-width: 27%;
    --tab-height: clamp(58px, 7cqw, 82px);
    --tab-curve: calc(var(--surface-radius) * 2);
    --tab-edge-curve: var(--surface-radius);

    --font-body: 'Cairo', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-display: 'Anton', 'Cairo', system-ui, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
}

body.has-hero {
    background: #d9dcdf;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

/* ------------------------------------------------------- frame and top bar */

.frame {
    padding: clamp(10px, 1.4vw, 20px);
}

.has-hero .frame {
    position: relative;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(10px, 1.4vw, 18px) clamp(14px, 2.4vw, 40px);
}

.has-hero .topbar {
    position: absolute;
    z-index: 80;
    top: clamp(10px, 1.4vw, 20px);
    inset-inline: clamp(10px, 1.4vw, 20px);
    height: clamp(70px, 7.5vw, 92px);
    padding-inline: clamp(24px, 4cqw, 58px);
}

.topbar__brand {
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 26px);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
}

.topbar__nav {
    display: flex;
    gap: clamp(14px, 2vw, 30px);
    align-items: center;
}

.topbar__nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
}

.topbar__nav a:hover,
.topbar__nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
}

.topbar__nav a:focus-visible,
.topbar__brand:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
}

.topbar__cart {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: 999px;
}

.topbar__cart:focus-visible {
    outline: 2px solid var(--hazard);
    outline-offset: 3px;
}

/*
 * Setting `display` on an element beats the browser's own `[hidden]{display:none}`,
 * so every element the component hides by attribute needs this or it renders as
 * an empty shape. The tab did exactly that on a slide with no tab word.
 */
.hero [hidden] {
    display: none !important;
}

/* --------------------------------------------------------------- empty state */

.hero__empty {
    position: absolute;
    inset: 0;
    z-index: 45;
    display: grid;
    place-content: center;
    gap: 10px;
    text-align: center;
    padding: 8cqw;
    color: rgba(237, 235, 230, 0.72);
}

.hero__empty strong {
    font-family: var(--font-display);
    font-size: clamp(20px, 3cqw, 34px);
    color: var(--paper);
}

.hero__empty p {
    font-size: clamp(12px, 1.4cqw, 15px);
    line-height: 1.9;
    max-width: 46ch;
}

.hero__empty code {
    font-family: ui-monospace, Consolas, monospace;
    background: rgba(237, 235, 230, 0.1);
    border-radius: 5px;
    padding: 2px 7px;
    font-size: 0.9em;
    direction: ltr;
    display: inline-block;
}

/* ---------------------------------------------------------------------------
   The card holds five stacked layers. Only the stage and the interface take
   pointer events; the text layers must not, or the front one would swallow
   every drag aimed at the canvas.
   --------------------------------------------------------------------------- */

.hero {
    display: block;
}

.has-hero .hero {
    --hero-surface-top: clamp(70px, 7.5vw, 92px);
}

.hero__card {
    position: relative;
    container-type: size;
    width: 100%;
    height: min(78svh, 760px);
    min-height: 500px;
    border-radius: var(--card-radius);
    overflow: hidden;
    isolation: isolate;
    background-color: var(--paper);
}

.hero__surface {
    position: absolute;
    top: var(--hero-surface-top);
    inset-inline: var(--hero-frame);
    bottom: var(--hero-frame);
    overflow: hidden;
    border-radius: var(--surface-radius);
    clip-path: shape(
        from 0 0,
        line to calc(100% - var(--tab-width) - var(--tab-curve)) 0,
        curve to calc(100% - var(--tab-width)) var(--tab-height)
            with calc(100% - var(--tab-width) - var(--tab-curve) * 0.18) 0 /
            calc(100% - var(--tab-width) - var(--tab-curve) * 0.82) var(--tab-height),
        line to calc(100% - var(--tab-edge-curve)) var(--tab-height),
        curve to 100% calc(var(--tab-height) + var(--tab-edge-curve))
            with calc(100% - var(--tab-edge-curve) * 0.45) var(--tab-height) /
            100% calc(var(--tab-height) + var(--tab-edge-curve) * 0.45),
        line to 100% 100%,
        line to 0 100%,
        close
    );
}

[dir='ltr'] .hero__surface {
    clip-path: shape(
        from 100% 0,
        line to calc(var(--tab-width) + var(--tab-curve)) 0,
        curve to var(--tab-width) var(--tab-height)
            with calc(var(--tab-width) + var(--tab-curve) * 0.18) 0 /
            calc(var(--tab-width) + var(--tab-curve) * 0.82) var(--tab-height),
        line to var(--tab-edge-curve) var(--tab-height),
        curve to 0 calc(var(--tab-height) + var(--tab-edge-curve))
            with calc(var(--tab-edge-curve) * 0.45) var(--tab-height) /
            0 calc(var(--tab-height) + var(--tab-edge-curve) * 0.45),
        line to 0 100%,
        line to 100% 100%,
        close
    );
}

.hero__bg {
    position: absolute;
    inset: -4%;
    z-index: 10;
    background-color: var(--card);
    background-position: center;
    background-size: cover;
    transition: background-color 0.45s ease;
    will-change: transform;
}

.hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 8%, rgba(255, 255, 255, 0.08), transparent 60%);
}

.hero__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
}

.hero__layer--back {
    z-index: 20;
    display: grid;
    place-items: center;
}

.hero__layer--front {
    z-index: 40;
}

.hero__wordmark {
    font-family: var(--font-display);
    font-size: clamp(62px, 21cqw, 250px);
    line-height: 0.82;
    letter-spacing: 0.01em;
    color: var(--paper);
    white-space: nowrap;
    transform: translateY(-8%);
}

/*
 * Every movable element reads the same two custom properties, in percent of the
 * card. They default to zero, so a slide with no saved layout sits exactly
 * where the stylesheet puts it and the editor only ever stores a difference.
 */
.hero__tab,
.hero__wordmark,
.hero__tagline,
.hero__stats {
    translate: calc(var(--dx, 0) * 1cqw) calc(var(--dy, 0) * 1cqh);
}

/* -------------------------------------------------------------- light tab */

.hero__tab {
    position: absolute;
    z-index: 60;
    top: var(--hero-surface-top);
    inset-inline-start: var(--hero-frame);
    width: var(--tab-width);
    height: calc(var(--tab-height) - var(--hero-frame));
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(18px, 3cqw, 42px);
}

.hero__tab-word {
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(13px, 1.7cqw, 19px);
    color: var(--ink);
    white-space: nowrap;
}

/* ------------------------------------------------------------------ stage */

.hero__stage {
    position: absolute;
    inset: 0;
    z-index: 30;
}

.hero__poster,
.hero__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
}

.hero__poster {
    object-fit: contain;
    object-position: center;
    transition: opacity 0.4s ease;
}

.hero__canvas {
    opacity: 0;
    transition: opacity 0.4s ease;
}

.hero__card.is-live .hero__canvas {
    opacity: 1;
}

.hero__card.is-live .hero__poster {
    opacity: 0;
}

/* --------------------------------------------------------- front elements */

.hero__tagline {
    position: absolute;
    inset-inline-start: clamp(18px, 5cqw, 64px);
    bottom: clamp(70px, 13cqw, 130px);
    max-width: min(34ch, 40cqw);
    color: rgba(237, 235, 230, 0.72);
    font-size: clamp(12px, 1.3cqw, 15px);
    line-height: 1.85;
}

/*
 * A band across the garment's lower half. Centring them is what makes the
 * stacking legible: these cards sit ON the product, which is the whole point of
 * the front layer.
 */
.hero__stats {
    position: absolute;
    inset-inline: 0;
    margin-inline: auto;
    width: max-content;
    max-width: 92cqw;
    bottom: clamp(86px, 17cqh, 160px);
    display: grid;
    grid-auto-flow: column;
    gap: clamp(10px, 1.4cqw, 16px);
}

/* Dark and translucent, so the values read over pale cloth and over the card
   alike; a light card would vanish against a white garment. */
.hero__stat {
    background: rgba(11, 11, 12, 0.58);
    border: 1px solid rgba(237, 235, 230, 0.16);
    backdrop-filter: blur(7px);
    border-radius: 16px;
    padding: clamp(11px, 1.5cqw, 18px) clamp(14px, 2cqw, 24px);
    min-width: clamp(110px, 15cqw, 168px);
}

.hero__stat-value {
    display: block;
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(17px, 2.3cqw, 32px);
    line-height: 1.1;
    color: var(--paper);
}

.hero__stat-label {
    display: block;
    margin-top: 3px;
    font-size: clamp(10px, 1.05cqw, 12px);
    color: rgba(237, 235, 230, 0.6);
}

/* ----------------------------------------------------------------- the UI */

.hero__ui {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
}

.hero__cta {
    position: absolute;
    bottom: clamp(20px, 4cqw, 44px);
    inset-inline-start: clamp(18px, 5cqw, 64px);
    pointer-events: auto;
    display: inline-block;
    background: var(--paper);
    color: var(--ink);
    border: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 900;
    font-size: 14px;
    text-decoration: none;
    padding: 14px 38px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition: background-color 0.2s, color 0.2s;
}

.hero__cta:hover {
    background: var(--hazard);
}

.hero__cta:focus-visible {
    outline: 3px solid var(--hazard);
    outline-offset: 3px;
}

.hero__dots {
    position: absolute;
    bottom: clamp(24px, 4cqw, 48px);
    inset-inline-end: clamp(18px, 5cqw, 64px);
    display: flex;
    gap: 9px;
    pointer-events: auto;
}

.hero__dot {
    width: 28px;
    height: 3px;
    background: rgba(237, 235, 230, 0.25);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.25s ease;
}

.hero__dot[aria-current='true'] {
    background: var(--paper);
}

.hero__dot:focus-visible {
    outline: 2px solid var(--hazard);
    outline-offset: 5px;
}

@container (max-width: 700px) {
    .hero__tagline {
        display: none;
    }

    /* Bigger than the garment is wide, so the word still runs out from behind it
       on a phone; at 21cqw the two are the same width and the effect vanishes. */
    .hero__wordmark {
        font-size: 27cqw;
    }

    /* High enough to still land on the garment's hem: the cards have to read as
       being in front of the product on a phone too, not below it. */
    .hero__stats {
        bottom: clamp(96px, 27cqh, 180px);
    }
}

@media (max-width: 820px) {
    :root {
        --card-radius: 36px;
        --hero-frame: 8px;
        --tab-width: 34%;
        --tab-height: 50px;
    }

    .hero__card {
        height: min(72svh, 620px);
    }

    .has-hero .hero {
        --hero-surface-top: 64px;
    }

    .has-hero .topbar {
        height: 64px;
    }

    /* inset-inline + auto margins, not a 50% offset plus a negative transform:
       the transform version lands off-centre in a right-to-left document. */
    .hero__cta {
        inset-inline: 0;
        margin-inline: auto;
        width: max-content;
        max-width: 84vw;
        bottom: 22px;
    }

    .hero__dots {
        inset-inline: 0;
        justify-content: center;
        bottom: 10px;
    }
}

@media (max-width: 700px) {
    /* The links do not fit beside the brand and the cart; the same routes are a
       tap away from the catalogue, so the row loses them rather than overflow. */
    .topbar__nav {
        display: none;
    }
}

/*
 * Below the 3D cut-off there is no scene to match, so the still may fill the
 * card instead of matching the camera. Its background is transparent, so cover
 * crops only empty space. The inset keeps the garment clear of the tab above it
 * and the call to action below.
 */
@media (max-width: 767px) {
    .hero__poster {
        /* An explicit height, not top+bottom: an absolutely positioned replaced
           element with height:auto falls back to its intrinsic ratio and ignores
           the bottom offset. */
        top: 9%;
        bottom: auto;
        height: 62%;
        object-fit: cover;
    }
}

@media (prefers-reduced-motion: reduce) {
    .hero__card *,
    .hero__card {
        transition: none !important;
        animation: none !important;
    }
}

/* --------------------------------------------------------------- credit */

.credit {
    padding: 22px clamp(14px, 2.4vw, 40px) 34px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
    max-width: 80ch;
}

.credit a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
}

.credit a:focus-visible {
    outline: 2px solid var(--hazard);
    outline-offset: 3px;
}
